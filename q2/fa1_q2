class Publication: #this is the main class that magazine and book class will inherit
    def __init__(self,title,author):
        self.__title = title
        self.__author = author
    def get_title(self):
        return self.__title
    def set_title(self):
        self.__title = title
    def get_author(self):
        return self.__author
    def set_author(self):
        self.__author = author
    def display(self):
        print(f"Title: {self.__title}")
        print(f"Author: {self.__author}")

class Book(Publication): # this is the Book class
    def __init__(self,title,author,no_of_pages):
        super().__init__(title,author)
        self.set_no_of_pages(no_of_pages)
    def get_no_of_pages(self): #getting the number of pages
        return self.__no_of_pages # getting the number pages
    def set_no_of_pages(self,no_of_pages):
        if no_of_pages <= 0:
            print("The number of pages must be positive.") #setting invalid value 
        else:
            self.__no_of_pages = no_of_pages
    def display(self):
        super().display()
        print(f"Number of pages: {self.__no_of_pages}")

class Magazine(Publication): # this the Magazine class 
    def __init__(self, title, author, issue_no):
        super().__init__(title, author)
        self.set_issue_no(issue_no)
    def get_issue_no(self):
        return self.__issue_no
    def set_issue_no(self,issue_no):
        if issue_no <= 0:
            print("The issue number must be positive.")
        else:
            self.__issue_no = issue_no
    def display(self):
        super().display()
        print(f"Issue Number: {self.__issue_no}")

pub1 = Publication("Journal of Experimental Psychology", "Ratchiff, R. & Van Dongen, H.")
